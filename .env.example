# ---------------------------------------------------------------------------
# Google Sheets Business Automation Platform - environment template
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# NEVER commit a real .env, OAuth token, or service-account key file.
# ---------------------------------------------------------------------------

# ----------------------------- Google Sheets -------------------------------
# Target spreadsheet id (the long id in the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
# Leave empty to run the pipeline in local dry-run mode (writes CSV/JSON locally).
GS_SPREADSHEET_ID=

# Authentication mode: "service_account" or "oauth".
GS_AUTH_MODE=service_account

# --- service_account mode ---
# Path to the service-account JSON key file (keep it OUTSIDE version control).
GS_SERVICE_ACCOUNT_FILE=credentials/service_account.json
# Alternatively provide the whole key as a single-line JSON string (CI secrets).
# If set, it takes precedence over GS_SERVICE_ACCOUNT_FILE.
GS_SERVICE_ACCOUNT_JSON=

# --- oauth mode ---
# Path to the OAuth client secrets JSON downloaded from Google Cloud Console.
GS_OAUTH_CLIENT_SECRETS_FILE=credentials/client_secret.json
# Where the cached user token is stored after the first interactive consent.
GS_OAUTH_TOKEN_FILE=credentials/token.json

# OAuth scopes (space separated). Only ask for what the app actually needs.
GS_SCOPES=https://www.googleapis.com/auth/spreadsheets

# --- worksheet names ---
GS_SHEET_RAW_DATA=Raw_Data
GS_SHEET_CLEAN_DATA=Clean_Data
GS_SHEET_DATA_QUALITY=Data_Quality
GS_SHEET_KPI_SUMMARY=KPI_Summary
GS_SHEET_PRODUCT_ANALYSIS=Product_Analysis
GS_SHEET_CATEGORY_ANALYSIS=Category_Analysis
GS_SHEET_REGIONAL_ANALYSIS=Regional_Analysis
GS_SHEET_AI_INSIGHTS=AI_Insights
GS_SHEET_FEEDBACK_ANALYSIS=Feedback_Analysis
GS_SHEET_RUN_LOG=Run_Log

# A1 range used when reading the raw input data.
GS_RAW_DATA_RANGE=A1:Z10000

# How many rows to keep in the Run_Log worksheet (oldest rows are trimmed).
GS_RUN_LOG_MAX_ROWS=500

# ------------------------------- Pipeline ---------------------------------
# Where logs are written (relative paths are resolved from the project root).
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log

# Where the local (dry-run) output sink writes CSV/JSON files.
LOCAL_OUTPUT_DIR=output

# Number of products shown in "top" / "bottom" performance lists.
TOP_N_PRODUCTS=5

# Records with a revenue value above this threshold are flagged for review
# during validation (outlier awareness, never auto-deleted).
REVENUE_OUTLIER_THRESHOLD=10000

# ------------------------ AI interpretation layer -------------------------
# Set AI_ENABLED=false to disable AI features entirely.
AI_ENABLED=true

# Provider selector: "openai_compatible" or "mock".
# "openai_compatible" works with OpenAI, OpenRouter, Groq, Ollama, LM Studio and
# any other gateway exposing the OpenAI chat-completions contract.
# "mock" is a deterministic offline provider (no key, no network) for demos/tests.
AI_PROVIDER=openai_compatible

# OpenAI-compatible API base URL. The "/chat/completions" path is appended
# automatically - trailing slashes are tolerated and the endpoint is never
# duplicated (see tests/unit/test_ai_provider_openrouter.py).
#   OpenAI:      AI_BASE_URL=https://api.openai.com/v1
#   OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1
AI_BASE_URL=https://api.openai.com/v1

# Model name. Keep it configurable - never hard-code it in Python.
#   OpenAI:      AI_MODEL=gpt-4o-mini
#   OpenRouter:  AI_MODEL=<vendor>/<model>[:variant]  e.g. qwen/qwen3.8-27b:free
# OpenRouter requires the "<vendor>/" prefix: a plain "qwen3.8-27b:free" is
# rejected at startup with a clear configuration error.
AI_MODEL=gpt-4o-mini

# Name of the environment variable that holds the API key.
# The key itself is NEVER written here.
AI_API_KEY_ENV=OPENAI_API_KEY

# The actual secret - read only by the AI provider at runtime.
# Works for OpenRouter keys too (keep the variable name for compatibility with
# the generic OpenAI-compatible provider abstraction).
OPENAI_API_KEY=

AI_TIMEOUT_SECONDS=60
AI_MAX_INPUT_CHARS=12000
# Output budget per request. Reasoning models (e.g. OpenRouter "qwen/..." slugs)
# spend part of this on hidden reasoning before writing the answer, so the
# default leaves room for both a reasoning pass and the full JSON narrative.
AI_MAX_OUTPUT_TOKENS=3000
AI_TEMPERATURE=0.2

# Reasoning control. "minimal" asks for the least thinking every endpoint accepts
# (recommended here: the KPI engine is authoritative and the model only
# verbalises verified numbers), "none" disables thinking entirely (rejected by
# endpoints where reasoning is mandatory), "low|medium|high|xhigh" request a
# specific effort, and "auto" omits the parameter so the model/provider default
# applies. If a provider rejects the field, the request is retried once without
# it. Reasoning params are only sent to OpenRouter hosts unless
# AI_SEND_REASONING_PARAMS overrides that.
AI_REASONING_EFFORT=minimal
# Optional explicit thinking budget (OpenRouter reasoning.max_tokens); empty = unset.
AI_REASONING_MAX_TOKENS=

# Set to true/false to force or suppress reasoning parameters for a non-OpenRouter
# gateway (default: automatic - they are only sent to OpenRouter hosts, so models
# that do not understand the field are never affected).
# AI_SEND_REASONING_PARAMS=

# Optional OpenRouter attribution headers - only sent when set.
AI_HTTP_REFERER=
AI_APP_TITLE=Google Sheets Business Automation

# Optional AI feedback-text classification (skipped automatically when the
# dataset has no text column).
AI_CLASSIFICATION_ENABLED=true
AI_CLASSIFICATION_CATEGORIES=positive,negative,neutral,complaint,product_feedback,delivery_feedback
AI_CLASSIFICATION_TEXT_COLUMN=feedback
AI_CLASSIFICATION_BATCH_SIZE=20
# Maximum number of feedback rows classified per run.
AI_CLASSIFICATION_MAX_ROWS=200

# ------------------------------ Scheduler ---------------------------------
# mode: "daily" | "weekly" | "interval"
SCHEDULE_MODE=daily
# 24h clock, HH:MM (daily/weekly modes)
SCHEDULE_TIME=07:30
# 0=Monday .. 6=Sunday (weekly mode)
SCHEDULE_DAY_OF_WEEK=0
# minutes between runs (interval mode)
SCHEDULE_INTERVAL_MINUTES=60
SCHEDULE_TIMEZONE=UTC
